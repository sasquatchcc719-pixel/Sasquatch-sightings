# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API Key for Harry (Sasquatch Analyst)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend API Key for email notifications (voicemails, Scout alerts)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Email address that receives Scout alert notifications (notify_charles tool)
OWNER_ALERT_EMAIL=sasquatchcc719@gmail.com

# Google Gemini API Key (Radar competitor dossiers only)
# Get your key at https://aistudio.google.com/app/apikey
# In Vercel, set the name exactly: GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key

# SerpApi for Radar rankings, GBP review sync, and public research fallback.
# Defaults are tuned for a 250 searches/month plan that renews on the 6th.
SERPAPI_API_KEY=your-serpapi-key
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_BILLING_CYCLE_DAY=6
RADAR_SERP_DAILY_CREDIT_BUDGET=6
GBP_REVIEW_SYNC_MAX_PAGES=1

# Operations / booking replacement feature flags
# Keep these off until the internal calendar is fully tested.
OPS_SMS_BOOKING_ENABLED=false
QUICKBOOKS_SYNC_ENABLED=false

# Optional: Restrict public/webhook endpoints (set to a secret string; callers must send it)
# STATS_PUBLIC_SECRET=  -> /api/stats/public requires header x-stats-secret
# TAP_TRACK_SECRET=    -> /api/tap/track requires header x-tap-secret or body.tapSecret
# WEBHOOK_SIGHTINGS_SECRET= -> /api/webhooks/new-sighting requires header x-webhook-secret or ?secret=

# Harry SMS dispatcher feature flags
OPENAI_API_KEY=your-openai-api-key
AI_DISPATCHER_ENABLED=false
HARRY_ANALYST_ENABLED=false
HARRY_ANALYST_HISTORY_READONLY=true

# Rabecca voice AI / Retell
RETELL_API_KEY=your-retell-api-key
RETELL_FUNCTION_SECRET=your-retell-custom-tool-shared-secret
REBECCA_VOICE_ENABLED=true
# Retell custom telephony SIP URI that Twilio press-1 scheduling should dial.
REBECCA_RETELL_SIP_URI=sip:+17192498791@sip.retellai.com

# Harry booking destination URLs
# BOOKING_PUBLIC_URL is the current website booking destination used by Harry when ops mode is OFF.
# OPS_BOOKING_PUBLIC_URL is the future operations booking destination used when "Use Ops Booking Destination" is ON.
BOOKING_PUBLIC_URL=https://sightings.sasquatchcarpet.com/book
OPS_BOOKING_PUBLIC_URL=https://sightings.sasquatchcarpet.com/book

# Telegram Bot for Admin Notifications (broadcast alerts for team/employees)
# Get bot token from @BotFather on Telegram
# Chat ID is your personal Telegram user ID (run scripts/get-telegram-chat-id.ts)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Square payment completion webhook
SQUARE_WEBHOOK_NOTIFICATION_URL=https://sightings.sasquatchcarpet.com/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# Harry Command Bot (Charles's personal conversation management bot)
# Create via @BotFather, separate from the notifications bot
HARRY_COMMAND_BOT_TOKEN=your-harry-command-bot-token
CHARLES_TELEGRAM_CHAT_ID=your-telegram-user-id

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API Key for Harry (Sasquatch Analyst)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend API Key for email notifications (voicemails)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Google Gemini API Key (Radar competitor dossiers only)
# Get your key at https://aistudio.google.com/app/apikey
# In Vercel, set the name exactly: GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key

# Operations / booking replacement feature flags
# Keep these off until the internal calendar is fully tested.
OPS_SMS_BOOKING_ENABLED=false
QUICKBOOKS_SYNC_ENABLED=false

# Optional: Restrict public/webhook endpoints (set to a secret string; callers must send it)
# STATS_PUBLIC_SECRET=  -> /api/stats/public requires header x-stats-secret
# TAP_TRACK_SECRET=    -> /api/tap/track requires header x-tap-secret or body.tapSecret
# WEBHOOK_SIGHTINGS_SECRET= -> /api/webhooks/new-sighting requires header x-webhook-secret or ?secret=

# Harry SMS dispatcher feature flags
OPENAI_API_KEY=your-openai-api-key
AI_DISPATCHER_ENABLED=false
HARRY_ANALYST_ENABLED=false
HARRY_ANALYST_HISTORY_READONLY=true

# Harry booking destination URLs
# BOOKING_PUBLIC_URL is the current website booking destination used by Harry when ops mode is OFF.
# OPS_BOOKING_PUBLIC_URL is the future operations booking destination used when "Use Ops Booking Destination" is ON.
BOOKING_PUBLIC_URL=https://sightings.sasquatchcarpet.com/book
OPS_BOOKING_PUBLIC_URL=https://sightings.sasquatchcarpet.com/book
